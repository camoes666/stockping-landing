---
import { siteConfig } from "../../config/site";

// 랜딩 페이지는 다크 히어로 위에 올라가므로 투명 배경 사용
// 다른 페이지는 흰 배경 헤더
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
---

<header class:list={[
  "border-b",
  isHome
    ? "border-slate-700/60 bg-slate-900"
    : "border-slate-200 bg-white"
]}>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class:list={[
        "text-sm font-bold tracking-tight",
        isHome ? "text-white" : "text-slate-900"
      ]}
    >
      {siteConfig.siteName}
    </a>
    <nav class:list={[
      "flex items-center gap-5 text-sm",
      isHome ? "text-slate-300" : "text-slate-600"
    ]}>
      <a href="/radar" class:list={[
        "transition",
        isHome ? "hover:text-white" : "hover:text-slate-900"
      ]}>이슈 레이더</a>
      <a href="/blog" class:list={[
        "transition",
        isHome ? "hover:text-white" : "hover:text-slate-900"
      ]}>블로그</a>
      <a href="/privacy" class:list={[
        "transition",
        isHome ? "hover:text-white" : "hover:text-slate-900"
      ]}>개인정보처리방침</a>
    </nav>
  </div>
</header>
