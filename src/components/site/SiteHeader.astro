---
import { siteConfig } from "../../config/site";

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
---

<header class="border-b border-[#362d59] bg-[#150f23]">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="text-sm font-bold tracking-tight text-white hover:text-[#c2ef4e] transition-colors duration-150"
    >
      {siteConfig.siteName}
    </a>
    <nav class="flex items-center gap-5 text-sm text-[#e5e7eb]">
      <a href="/radar" class="transition-colors duration-150 hover:text-[#6a5fc1]">이슈 레이더</a>
      <a href="/blog" class="transition-colors duration-150 hover:text-[#6a5fc1]">블로그</a>
      <a href="/privacy" class="transition-colors duration-150 hover:text-[#6a5fc1]">개인정보처리방침</a>
    </nav>
  </div>
</header>
