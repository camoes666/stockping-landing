---
import type { DailyIssue } from "../../data/daily-issues";
import { CtaButton } from "../ui/CtaButton";
import { links } from "../../config/links";

interface Props {
  issue: DailyIssue;
}

const { issue } = Astro.props;

const ISSUE_BADGE: Record<string, string> = {
  "확인된 사실": "bg-emerald-100 text-emerald-700 border border-emerald-200",
  "시장 관측": "bg-blue-100 text-blue-700 border border-blue-200",
  "루머": "bg-amber-100 text-amber-700 border border-amber-200",
};
const badgeClass = ISSUE_BADGE[issue.category] ?? "bg-[#e4dcff] text-[#362d59] border border-[#c4b5fd]";
---

<article class="bg-white rounded-xl border border-[#e4dcff] p-6 shadow-sm transition-all duration-200 hover:shadow-md hover:border-[#c4b5fd]">
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <span class={`rounded px-3 py-1 text-xs font-bold uppercase tracking-[0.2px] ${badgeClass}`}>
      {issue.category}
    </span>
    <div class="flex flex-wrap gap-1.5">
      {issue.relatedSymbols.map((sym) => (
        <span class="bg-[#f0eeff] text-[#6a5fc1] text-xs font-mono font-semibold rounded border border-[#e4dcff] px-2 py-0.5">
          {sym}
        </span>
      ))}
    </div>
  </div>

  <h2 class="text-[#1f1633] text-xl font-bold leading-snug mb-5">{issue.headline}</h2>

  <dl class="space-y-4 text-sm leading-6">
    <div>
      <dt class="text-[#1f1633] font-semibold mb-1">확인된 사실</dt>
      <dd class="text-[#4a3f6b]">{issue.confirmedFacts}</dd>
    </div>
    <div>
      <dt class="text-[#1f1633] font-semibold mb-1">시장 관측</dt>
      <dd class="text-[#4a3f6b]">{issue.marketObservation}</dd>
    </div>
    <div>
      <dt class="text-[#1f1633] font-semibold mb-1">투자자가 볼 포인트</dt>
      <dd>
        <ul class="mt-1 list-disc list-inside space-y-1 text-[#4a3f6b]">
          {issue.watchPoints.map((point) => <li>{point}</li>)}
        </ul>
      </dd>
    </div>
    <div>
      <dt class="text-[#1f1633] font-semibold mb-1">앱에서 확인 가능한 데이터</dt>
      <dd class="flex flex-wrap gap-2 mt-1">
        {issue.appDataPoints.map((point) => (
          <span class="bg-[#f0eeff] text-[#4a3f6b] rounded border border-[#e4dcff] px-2 py-0.5 text-xs">{point}</span>
        ))}
      </dd>
    </div>
  </dl>

  <div class="mt-6">
    <CtaButton href={links.playStore} label="앱에서 자세히 보기" variant="primary" />
  </div>
</article>
