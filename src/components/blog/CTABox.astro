---
import { ctaCopy, type CtaType } from "./cta-copy";
import { TrackedCtaButton } from "../islands/TrackedCtaButton";
import { links } from "../../config/links";

interface Props {
  ctaType: CtaType;
  page?: string;
}

const { ctaType, page = "blog" } = Astro.props;
const copy = ctaCopy[ctaType];
---

<div class="bg-[#1f1633] border border-[#362d59] rounded-xl p-6 my-8">
  <p class="text-[#c2ef4e] text-xs font-bold uppercase tracking-[0.2px] mb-2">앱에서 더 보기</p>
  <p class="text-white font-bold text-lg mb-4">{copy.headline}</p>
  <div class="flex flex-col gap-2 sm:flex-row">
    <TrackedCtaButton
      client:load
      href={links.playStore}
      label={copy.button}
      page={page}
      section={`cta-box:${ctaType}`}
      variant="lime"
    />
    <a
      href={links.appStore}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#362d59] bg-white/10 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-white/15"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
      App Store
    </a>
  </div>
</div>
