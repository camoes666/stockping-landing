---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import { TrackedCtaButton } from "../components/islands/TrackedCtaButton";
import { FaqAccordion } from "../components/islands/FaqAccordion";
import { siteConfig } from "../config/site";
import { links } from "../config/links";
---

<BaseLayout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription}>

  <!-- ════════════════════════════════════════════
       1. HERO — 메인 카피 + CTA
  ════════════════════════════════════════════ -->
  <section class="bg-[#1f1633] px-4 pb-0 pt-14 sm:px-6 lg:px-8" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(106,95,193,0.18) 0%, transparent 70%), #1f1633;">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">

        <!-- Left: Copy -->
        <div>
          <!-- Eyebrow -->
          <span class="animate-fade-up-0 inline-flex items-center gap-2 rounded-full border border-[#362d59] bg-[#150f23] px-4 py-1.5 text-sm font-semibold text-[#c2ef4e]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#c2ef4e] animate-pulse"></span>
            한국 투자자를 위한 미국주식 정보 앱
          </span>

          <!-- H1 -->
          <h1 class="animate-fade-up-1 mt-6 text-4xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-[58px]">
            미국주식 정보,<br />
            <span class="text-[#c2ef4e]">이제 한곳에서</span><br />
            확인하세요
          </h1>

          <!-- Sub-headline -->
          <p class="animate-fade-up-2 mt-5 max-w-xl text-lg leading-8 text-[#e5e7eb]/70">
            뉴스·루머·리포트·ETF 분석·내부자 거래까지.<br />
            여러 사이트를 오가지 않아도, 스톡핑 하나로 미국장 핵심 정보를 매일 확인합니다.
          </p>

          <!-- CTAs -->
          <div class="animate-fade-up-3 mt-8 flex flex-wrap gap-3">
            <TrackedCtaButton
              client:load
              href={links.playStore}
              label="플레이스토어에서 무료 다운로드"
              page="index"
              section="hero"
              variant="lime"
            />
            <a
              href="/radar"
              class="inline-flex items-center justify-center rounded-xl border border-[#362d59] bg-white/5 px-6 py-3.5 text-sm font-semibold text-[#e5e7eb] backdrop-blur-sm transition hover:bg-[rgba(54,22,107,0.3)] hover:border-[#584674]"
            >
              오늘의 이슈 레이더 보기 →
            </a>
          </div>
          <!-- Trust micro-copy -->
          <p class="animate-fade-up-4 mt-3 text-sm text-[#e5e7eb]/40">
            무료 다운로드 · 특정 종목 추천 없음 · 현재 Android(구글 플레이) 서비스 중
          </p>
        </div>

        <!-- Right: App demo video -->
        <div class="relative flex items-center justify-center pt-10 pb-4 lg:pt-4">
          <!-- Ambient glow -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="h-72 w-72 rounded-full bg-[#6a5fc1]/20 blur-3xl"></div>
          </div>

          <!-- Video container -->
          <div class="relative z-10 w-full max-w-lg animate-float-center">
            <div
              class="overflow-hidden rounded-2xl"
              style="
                border: 1px solid rgba(106,95,193,0.4);
                box-shadow: 0 24px 60px rgba(0,0,0,0.7), 0 0 40px rgba(106,95,193,0.2), inset 0 0 0 1px rgba(255,255,255,0.04);
              "
            >
              <video
                src="/stock-ping.mp4"
                autoplay
                muted
                loop
                playsinline
                class="block w-full h-auto"
              ></video>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       2. PROBLEM AGITATION — Pain Point 공감
  ════════════════════════════════════════════ -->
  <section class="bg-[#150f23] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#c2ef4e]">혹시 이런 경험 있으신가요?</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
          미국주식 정보, 찾는 것만 해도<br />
          <span class="text-[#e5e7eb]/40">지칩니다</span>
        </h2>
      </div>
      <div class="mx-auto mt-12 max-w-4xl grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-[#362d59] bg-[#1f1633]/80 p-7 backdrop-blur-sm">
          <div class="mb-3 text-3xl">🌐</div>
          <h3 class="text-lg font-bold text-white">영어 뉴스는 빠른데, 번역이 느리다</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            미국 현지 뉴스는 영어로 올라오고, 한국어 번역은 몇 시간씩 늦는다. 중요한 이슈를 늦게 아는 경우가 잦다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#1f1633]/80 p-7 backdrop-blur-sm">
          <div class="mb-3 text-3xl">🔀</div>
          <h3 class="text-lg font-bold text-white">루머와 사실이 뒤섞여 판단이 어렵다</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            SNS에서 퍼지는 이슈가 확인된 사실인지 루머인지 구분이 안 된다. 잘못된 정보에 반응하기 쉽다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#1f1633]/80 p-7 backdrop-blur-sm">
          <div class="mb-3 text-3xl">📂</div>
          <h3 class="text-lg font-bold text-white">사이트를 5개씩 열어야 한다</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            뉴스는 야후파이낸스, ETF는 ETF.com, 내부자 거래는 OpenInsider, 리포트는 시킹알파... 한 번에 볼 수 있는 곳이 없다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#1f1633]/80 p-7 backdrop-blur-sm">
          <div class="mb-3 text-3xl">⏰</div>
          <h3 class="text-lg font-bold text-white">정보를 찾다가 정작 흐름을 놓친다</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            각 정보를 따로 찾아다니다 보면 시간이 지나 정작 시장의 큰 흐름이나 종목 움직임을 놓치는 경우가 생긴다.
          </p>
        </div>
      </div>
      <!-- Bridge -->
      <div class="mx-auto mt-10 max-w-xl text-center">
        <p class="text-lg font-semibold text-[#e5e7eb]/80">
          이제 한 앱에서 해결하는 방법이 있습니다.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. SOLUTION — Before / After + 3단계 워크플로
  ════════════════════════════════════════════ -->
  <section class="bg-[#1f1633] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#6a5fc1]">Solution</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
          스톡핑은 흩어진 미국주식 정보를<br />
          <span class="text-[#c2ef4e]">하나로 모읍니다</span>
        </h2>
        <p class="mt-4 text-base text-[#e5e7eb]/60">
          여러 사이트를 오가는 대신, 스톡핑 하나에서 매일 확인하는 습관을 만드세요.
        </p>
      </div>

      <!-- Before / After table -->
      <div class="mx-auto mb-16 max-w-3xl overflow-hidden rounded-2xl border border-[#362d59]">
        <div class="grid grid-cols-2">
          <div class="border-b border-r border-[#362d59] bg-[#150f23] px-4 py-3.5 text-center text-sm font-bold text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">
            기존 방법
          </div>
          <div class="border-b border-[#362d59] bg-[#6a5fc1]/10 px-4 py-3.5 text-center text-sm font-bold text-[#c2ef4e] sm:px-6 sm:py-4 sm:text-base">
            스톡핑
          </div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">🌐 영어 뉴스 직접 번역</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 한국어 뉴스 번역 제공</div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">🔀 루머·사실 구분 불가</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 사실·관측·루머 분류</div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">📂 사이트 5개+ 오가기</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 뉴스·ETF·리포트 한곳</div>
          <div class="border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">⏰ 정보 찾다 흐름 놓침</div>
          <div class="px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 매일 핵심 이슈 정리</div>
        </div>
      </div>

      <!-- 3-step workflow -->
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#6a5fc1] text-2xl font-black text-white shadow-[rgba(106,95,193,0.35)_0px_4px_20px]">1</div>
          <h3 class="text-xl font-bold text-white">이슈 확인</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            오늘의 이슈 레이더에서 확인된 사실·시장 관측·루머를 한눈에 확인합니다.
          </p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#6a5fc1] text-2xl font-black text-white shadow-[rgba(106,95,193,0.35)_0px_4px_20px]">2</div>
          <h3 class="text-xl font-bold text-white">데이터 분석</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            관련 종목의 뉴스·애널리스트 리포트·ETF 비중·내부자 거래를 앱에서 이어서 확인합니다.
          </p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#6a5fc1] text-2xl font-black text-white shadow-[rgba(106,95,193,0.35)_0px_4px_20px]">3</div>
          <h3 class="text-xl font-bold text-white">스스로 판단</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            추천주 없이, 내가 직접 확인한 데이터를 바탕으로 투자 판단을 내립니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       4. SOCIAL PROOF — 신뢰 지표
  ════════════════════════════════════════════ -->
  <section class="border-y border-[#362d59] bg-[#150f23] px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <p class="mb-8 text-center text-xs font-bold uppercase tracking-[0.2px] text-[#e5e7eb]/30">Why 스톡핑?</p>
      <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
        <div>
          <p class="text-4xl font-bold text-white">매일</p>
          <p class="mt-2 text-sm text-[#e5e7eb]/50">미국장 핵심 이슈 업데이트</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-white">3가지</p>
          <p class="mt-2 text-sm text-[#e5e7eb]/50">사실·관측·루머 분류 제공</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-white">6개+</p>
          <p class="mt-2 text-sm text-[#e5e7eb]/50">통합 정보 카테고리</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#c2ef4e]">무료</p>
          <p class="mt-2 text-sm text-[#e5e7eb]/50">기본 기능 다운로드</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       5. FEATURES — 6개 핵심 기능
  ════════════════════════════════════════════ -->
  <section class="bg-[#1f1633] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#6a5fc1]">Features</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">하나의 앱에서 모두 확인</h2>
        <p class="mt-4 text-base text-[#e5e7eb]/60">미국주식 투자자가 매일 확인해야 할 정보를 6개 카테고리로 정리했습니다.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
          <div class="mb-4 text-4xl">📰</div>
          <h3 class="text-xl font-bold text-white">뉴스 번역</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            미국 현지 영어 뉴스를 한국어로 빠르게 확인합니다. 영어 장벽 없이 미국장 소식을 실시간으로 파악합니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
          <div class="mb-4 text-4xl">🎯</div>
          <h3 class="text-xl font-bold text-white">이슈 레이더</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            오늘의 미국장 이슈를 확인된 사실·시장 관측·루머 세 가지로 분류해 정리합니다. SNS 루머를 사실처럼 믿는 일을 줄입니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
          <div class="mb-4 text-4xl">📊</div>
          <h3 class="text-xl font-bold text-white">애널리스트 리포트</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            주요 증권사의 목표가·투자등급 변화를 한눈에 확인합니다. 어닝콜 요약도 제공합니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
          <div class="mb-4 text-4xl">🗂️</div>
          <h3 class="text-xl font-bold text-white">ETF 네비게이터</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            QQQ·SCHD·SPY 등 주요 ETF의 보유 종목·비중·배당·수수료를 한곳에서 분석합니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
          <div class="mb-4 text-4xl">🕵️</div>
          <h3 class="text-xl font-bold text-white">내부자 거래</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            CEO·임원진의 실제 주식 매수·매도 데이터를 확인합니다. 회사 내부 신호를 직접 확인하세요.
          </p>
        </div>
        <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
          <div class="mb-4 text-4xl">🏛️</div>
          <h3 class="text-xl font-bold text-white">상하원 의원 매매</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">
            미국 상하원 의원의 주식 거래 내역을 추적합니다. 정치·정책 흐름과 연계해 확인할 수 있습니다.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       6. OFFER / PRICING — 무료 vs. 인앱 결제
  ════════════════════════════════════════════ -->
  <section class="bg-[#150f23] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="mb-10 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#c2ef4e]">Pricing</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">먼저 무료로 시작하세요</h2>
        <p class="mt-4 text-base text-[#e5e7eb]/60">기본 기능은 무료입니다. 더 깊은 분석은 앱 내 결제로 이용할 수 있습니다.</p>
      </div>
      <div class="overflow-hidden rounded-2xl border border-[#362d59]">
        <div class="grid grid-cols-2 border-b border-[#362d59]">
          <div class="bg-[#1f1633] px-4 py-4 text-center text-sm font-bold text-[#e5e7eb]/60 sm:px-6 sm:text-base">무료</div>
          <div class="bg-[#6a5fc1]/10 px-4 py-4 text-center text-sm font-bold text-[#c2ef4e] sm:px-6 sm:text-base">인앱 결제</div>
        </div>
        <div class="grid grid-cols-2">
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/70 sm:px-6 sm:text-base">✅ 뉴스 번역</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#c2ef4e]/80 sm:px-6 sm:text-base">✅ 애널리스트 리포트</div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/70 sm:px-6 sm:text-base">✅ 이슈 레이더</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#c2ef4e]/80 sm:px-6 sm:text-base">✅ 내부자 거래 전체</div>
