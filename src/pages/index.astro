---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TrackedCtaButton } from "../components/islands/TrackedCtaButton";
import { FaqAccordion } from "../components/islands/FaqAccordion";
import IssueCarousel from "../components/radar/IssueCarousel.astro";
import { siteConfig } from "../config/site";
import { links } from "../config/links";
import { dailyIssues, type DailyIssue } from "../data/daily-issues";
import { supabase, rowToIssue, type DailyIssueRow } from "../lib/supabase";

// 이슈 레이더 상위 3개 fetch (Supabase → fallback 정적 데이터)
let previewIssues: DailyIssue[] = dailyIssues.slice(0, 5);

if (supabase) {
  const { data, error } = await supabase
    .from("daily_issues")
    .select("*")
    .eq("is_published", true)
    .order("display_order", { ascending: true })
    .order("created_at", { ascending: false })
    .limit(5);

  if (!error && data && data.length > 0) {
    previewIssues = (data as DailyIssueRow[]).map(rowToIssue);
  }
}
---

<BaseLayout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription}>

  <!-- ════════════════════════════════════════════
       1. HERO — DARK
  ════════════════════════════════════════════ -->
  <section class="bg-[#1f1633] px-4 pb-0 pt-14 sm:px-6 lg:px-8" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(106,95,193,0.18) 0%, transparent 70%), #1f1633;">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 items-center gap-6 lg:gap-2 lg:grid-cols-[58%,42%]">

        <!-- Left: Copy -->
        <div>
          <span class="animate-fade-up-0 inline-flex items-center gap-2 rounded-full border border-[#362d59] bg-[#150f23] px-4 py-1.5 text-sm font-semibold text-[#c2ef4e]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#c2ef4e] animate-pulse"></span>
            한국 투자자를 위한 미국주식 정보 앱
          </span>
          <h1 class="mt-6 leading-[1.08] tracking-tight">
            <!-- 줄 1: 왼쪽에서 슬라이드 -->
            <div class="overflow-hidden pb-2">
              <span class="block animate-slide-left font-black text-white text-5xl sm:text-6xl lg:text-[70px]">
                미국장 열리기 전,
              </span>
            </div>
            <!-- 줄 2: 오른쪽에서 슬라이드 + lime glow -->
            <div class="overflow-hidden pb-2">
              <span class="block animate-slide-right font-black text-4xl sm:text-5xl lg:text-[58px]">
                <span class="text-[#c2ef4e]" style="animation: slideFromRight 0.9s cubic-bezier(0.16,1,0.3,1) 0.38s both, limePulse 2.5s ease-in-out 1.4s infinite;">정보 찾느라 시간 쓰지 말고</span>
              </span>
            </div>
            <!-- 줄 3: 왼쪽에서 슬라이드 -->
            <div class="overflow-hidden pb-1">
              <span class="block animate-slide-left font-black text-white text-4xl sm:text-5xl lg:text-[58px]" style="animation: slideFromLeft 0.9s cubic-bezier(0.16,1,0.3,1) 0.6s both;">
                스톡핑을 열어보세요
              </span>
            </div>
          </h1>
          <style>
            @keyframes limePulse {
              0%, 100% { text-shadow: 0 0 0px rgba(194,239,78,0); }
              50%       { text-shadow: 0 0 30px rgba(194,239,78,0.8), 0 0 60px rgba(194,239,78,0.3); }
            }
          </style>
          <p class="animate-fade-up-4 mt-5 max-w-xl text-lg leading-8 text-[#e5e7eb]/70">
            뉴스·루머·리포트·ETF 분석·내부자 거래까지.<br />
            <span class="text-[#c2ef4e] font-semibold">스톡핑</span>이 오늘 봐야 할 미국장 정보를 한곳에 정리합니다.
          </p>
          <div class="animate-fade-up-5 mt-8 flex flex-wrap gap-3">
            <TrackedCtaButton
              client:load
              href={links.playStore}
              label="플레이스토어에서 무료로 시작하기"
              page="index"
              section="hero"
              variant="lime"
            />
            <a
              href="/radar"
              class="inline-flex items-center justify-center rounded-xl border border-[#362d59] bg-white/5 px-6 py-3.5 text-sm font-semibold text-[#e5e7eb] backdrop-blur-sm transition hover:bg-[rgba(54,22,107,0.3)] hover:border-[#584674]"
            >
              오늘의 이슈 레이더 보기 →
            </a>
          </div>
          <p class="animate-fade-up-6 mt-3 text-sm text-[#e5e7eb]/40">
            특정 종목 추천 없음 · Android 서비스 중 · 기본 기능 무료
          </p>
        </div>

        <!-- Right: App demo video -->
        <div class="relative flex items-center justify-center pt-10 pb-4 lg:pt-4">
          <!-- Ambient glow -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="h-72 w-72 rounded-full bg-[#6a5fc1]/20 blur-3xl"></div>
          </div>
          <!-- Video container -->
          <div class="relative z-10 w-full max-w-xs sm:max-w-sm">
            <div
              class="overflow-hidden rounded-2xl"
              style="border: 1px solid rgba(106,95,193,0.4); box-shadow: 0 24px 60px rgba(0,0,0,0.7), 0 0 40px rgba(106,95,193,0.2), inset 0 0 0 1px rgba(255,255,255,0.04);"
            >
              <video
                src="/stock-ping-v01.mp4"
                autoplay
                muted
                loop
                playsinline
                class="block w-full h-full object-cover"
                style="aspect-ratio: 3/4;"
              ></video>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       2. PROBLEM — LIGHT
  ════════════════════════════════════════════ -->
  <section class="bg-[#f0eeff] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#6a5fc1]">혹시 이런 경험 있으신가요?</p>
        <h2 class="mt-3 text-3xl font-bold text-[#1f1633] sm:text-4xl">
          미국주식 정보, 찾는 것만 해도<br />
          <span class="text-[#79628c]">지칩니다</span>
        </h2>
      </div>
      <div class="mx-auto mt-12 max-w-4xl grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-[#e4dcff] bg-white p-7 shadow-sm">
          <div class="mb-3 text-3xl">🌐</div>
          <h3 class="text-lg font-bold text-[#1f1633]">영어 뉴스는 빠른데, 이해는 늦어진다</h3>
          <p class="mt-3 text-base leading-8 text-[#4a3f6b]">
            미국 현지 뉴스는 빠르게 올라오지만, 한국어로 이해할 때는 이미 시장이 움직인 뒤일 때가 많습니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#e4dcff] bg-white p-7 shadow-sm">
          <div class="mb-3 text-3xl">🔀</div>
          <h3 class="text-lg font-bold text-[#1f1633]">루머와 사실이 뒤섞여 판단이 흔들린다</h3>
          <p class="mt-3 text-base leading-8 text-[#4a3f6b]">
            SNS에는 매일 새로운 이슈가 쏟아집니다. 하지만 무엇이 확인된 사실이고, 무엇이 시장 관측인지 구분하기 어렵습니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#e4dcff] bg-white p-7 shadow-sm">
          <div class="mb-3 text-3xl">📂</div>
          <h3 class="text-lg font-bold text-[#1f1633]">ETF·리포트·내부자 거래를 따로 찾아야 한다</h3>
          <p class="mt-3 text-base leading-8 text-[#4a3f6b]">
            뉴스는 뉴스 사이트에서, ETF는 ETF 사이트에서, 내부자 거래와 리포트는 또 다른 곳에서 확인해야 합니다. 미국장 정보는 너무 흩어져 있습니다.
          </p>
        </div>
        <div class="rounded-2xl border border-[#e4dcff] bg-white p-7 shadow-sm">
          <div class="mb-3 text-3xl">⏰</div>
          <h3 class="text-lg font-bold text-[#1f1633]">정보를 찾는 동안 중요한 흐름을 놓친다</h3>
          <p class="mt-3 text-base leading-8 text-[#4a3f6b]">
            여러 사이트를 오가다 보면 시간이 지나고, 정작 오늘 미국장에서 봐야 할 큰 흐름을 놓치기 쉽습니다.
          </p>
        </div>
      </div>
      <div class="mx-auto mt-10 max-w-xl text-center">
        <p class="text-lg font-semibold text-[#362d59]">
          이제 스톡핑에서 한 번에 확인하세요.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. SOLUTION — DARK
  ════════════════════════════════════════════ -->
  <section class="bg-[#1f1633] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#6a5fc1]">Solution</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
          <span class="text-[#c2ef4e]">스톡핑</span>은 흩어진 미국장 정보를<br />
          <span class="text-[#c2ef4e]">투자자가 보기 쉬운 순서로 다시 정리합니다</span>
        </h2>
        <p class="mt-4 text-base text-[#e5e7eb]/60">
          뉴스는 한국어로, 루머는 사실과 구분해서, ETF와 리포트는 한 화면에서 확인하세요. 추천주 없이, 데이터를 보고 스스로 판단할 수 있게 <span class="text-[#c2ef4e] font-semibold">스톡핑</span>이 돕습니다.
        </p>
      </div>

      <!-- Before / After table -->
      <div class="mx-auto mb-16 max-w-3xl overflow-hidden rounded-2xl border border-[#362d59]">
        <div class="grid grid-cols-2">
          <div class="border-b border-r border-[#362d59] bg-[#150f23] px-4 py-3.5 text-center text-sm font-bold text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">기존 방법</div>
          <div class="border-b border-[#362d59] bg-[#6a5fc1]/10 px-4 py-3.5 text-center text-sm font-bold text-[#c2ef4e] sm:px-6 sm:py-4 sm:text-base">스톡핑</div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">🌐 영어 뉴스 직접 번역</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 미국 현지 뉴스를 한국어로 빠르게 이해</div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">🔀 루머·사실 구분 어려움</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 확인된 사실·시장 관측·루머를 분리</div>
          <div class="border-b border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">📂 사이트 여러 개 이동</div>
          <div class="border-b border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 뉴스·ETF·리포트·내부자 거래를 한곳에서 확인</div>
          <div class="border-r border-[#362d59]/50 px-4 py-3.5 text-sm text-[#e5e7eb]/50 sm:px-6 sm:py-4 sm:text-base">⏰ 정보 찾다 흐름 놓침</div>
          <div class="px-4 py-3.5 text-sm text-[#e5e7eb]/80 sm:px-6 sm:py-4 sm:text-base">✅ 미국장 보기 전 핵심 이슈를 먼저 정리</div>
        </div>
      </div>

      <!-- 3-step -->
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#6a5fc1] text-2xl font-black text-white shadow-[rgba(106,95,193,0.35)_0px_4px_20px]">1</div>
          <h3 class="text-xl font-bold text-white">이슈 확인</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">오늘의 이슈 레이더에서 확인된 사실·시장 관측·루머를 먼저 구분합니다.</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#6a5fc1] text-2xl font-black text-white shadow-[rgba(106,95,193,0.35)_0px_4px_20px]">2</div>
          <h3 class="text-xl font-bold text-white">데이터 연결</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">관련 종목의 뉴스·애널리스트 리포트·ETF 비중·내부자 거래를 이어서 확인합니다.</p>
        </div>
        <div class="text-center">
          <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#6a5fc1] text-2xl font-black text-white shadow-[rgba(106,95,193,0.35)_0px_4px_20px]">3</div>
          <h3 class="text-xl font-bold text-white">스스로 판단</h3>
          <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">특정 종목 추천 없이, 직접 확인한 데이터를 바탕으로 투자 판단에 참고합니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       4. SOCIAL PROOF — LIGHT
  ════════════════════════════════════════════ -->
  <section class="bg-[#f0eeff] px-4 py-12 sm:px-6 lg:px-8 border-y border-[#e4dcff]">
    <div class="mx-auto max-w-7xl">
      <p class="mb-8 text-center text-xs font-bold uppercase tracking-[0.2px] text-[#79628c]">Why <span class="text-[#6a5fc1]">스톡핑</span>?</p>
      <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
        <div>
          <p class="text-4xl font-bold text-[#1f1633]">매일</p>
          <p class="mt-2 text-sm text-[#4a3f6b]">미국장 핵심 이슈 정리</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#1f1633]">3가지</p>
          <p class="mt-2 text-sm text-[#4a3f6b]">사실·관측·루머 구분</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#1f1633]">6개+</p>
          <p class="mt-2 text-sm text-[#4a3f6b]">미국주식 정보 카테고리</p>
        </div>
        <div>
          <p class="text-4xl font-bold text-[#6a5fc1]">무료</p>
          <p class="mt-2 text-sm text-[#4a3f6b]">기본 기능으로 시작</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       5. FEATURES — DARK
  ════════════════════════════════════════════ -->
  <section class="bg-[#1f1633] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mb-12 text-center">
        <p class="text-xs font-bold uppercase tracking-[0.2px] text-[#6a5fc1]">Features</p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">미국장 보기 전 확인할 정보를 하나의 앱에 담았습니다</h2>
        <p class="mt-4 text-base text-[#e5e7eb]/60">뉴스, 이슈, 리포트, ETF, 내부자 거래, 상하원 의원 매매까지 미국주식 투자자가 매일 확인해야 할 데이터를 정리했습니다.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { icon: "📰", title: "영어 뉴스, 기다리지 말고 바로 이해하세요", desc: "미국 현지 뉴스를 한국어로 정리해 중요한 이슈를 더 빠르게 확인할 수 있습니다." },
          { icon: "🎯", title: "루머를 믿기 전에, 먼저 구분하세요", desc: "오늘의 미국장 이슈를 확인된 사실·시장 관측·루머로 나눠 보여줘 잘못된 정보에 흔들리는 일을 줄입니다." },
          { icon: "📊", title: "월가 리포트 흐름을 쉽게 확인하세요", desc: "주요 증권사의 목표가·투자등급 변화와 어닝콜 핵심 내용을 한국 투자자 눈높이에 맞게 정리합니다." },
          { icon: "🗂️", title: "ETF 이름만 보지 말고, 안에 든 종목까지 보세요", desc: "QQQ·SCHD·SPY 등 주요 ETF의 보유 종목·비중·배당·수수료를 한곳에서 확인할 수 있습니다." },
          { icon: "🕵️", title: "내부자 거래는 따라 사는 신호가 아닙니다", desc: "CEO·임원진의 매수·매도 공시를 투자 참고 데이터로 확인합니다. 내부자 거래는 시장을 이해하기 위한 보조 정보입니다." },
          { icon: "🏛️", title: "미국 정치인의 매매 흐름도 참고 데이터로 확인하세요", desc: "미국 상하원 의원의 주식 거래 내역을 추적해 정치·정책 이슈와 시장 흐름을 함께 살펴볼 수 있습니다." },
        ].map((f) => (
          <div class="rounded-2xl border border-[#362d59] bg-[#150f23] p-7 transition-all duration-200 hover:border-[#6a5fc1]/50 hover:shadow-[rgba(106,95,193,0.1)_0px_8px_32px]">
            <div class="mb-4 text-4xl">{f.icon}</div>
            <h3 class="text-xl font-bold text-white">{f.title}</h3>
            <p class="mt-3 text-base leading-8 text-[#e5e7eb]/60">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       6. ISSUE RADAR PREVIEW — LIGHT
  ════════════════════════════════════════════ -->
  <section class="bg-[#f0eeff] px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">

      <!-- Header -->
      <div class="mb-10 flex flex-col items-start gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-[#6a5fc1]/30 bg-white px-3 py-1 text-xs font-bold uppercase tracking-[0.15em] text-[#6a5fc1]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#6a5fc1] animate-pulse"></span>
            오늘의 이슈 레이더
          </span>
          <h2 class="mt-3 text-3xl font-bold text-[#1f1633] sm:text-4xl">
            루머를 믿기 전에,<br class="sm:hidden" /> 먼저 구분하세요
          </h2>
          <p class="mt-2 text-base text-[#4a3f6b]">스톡핑은 오늘의 미국장 이슈를 확인된 사실과 시장 관측으로 나눠 정리합니다</p>
        </div>
        <a
          href="/radar"
