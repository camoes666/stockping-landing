---
export const prerender = true;
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import { siteConfig } from "../../config/site";
import { CATEGORY_LABELS, CATEGORY_OPTIONS, CATEGORY_BADGE, formatKoreanDate } from "../../lib/blog-constants";

const posts = await getCollection("blog");
const sorted = posts.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const featured = sorted[0];
const rest = sorted.slice(1);
---

<BaseLayout
  title={`미국주식 투자 정보 블로그 | ${siteConfig.siteName}`}
  description="미국주식 ETF, 뉴스/루머, 애널리스트 리포트, 내부자 거래 정보를 한국어로 정리합니다."
>

  <!-- Hero — DARK -->
  <div class="bg-[#1f1633]" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(106,95,193,0.2) 0%, transparent 70%), #1f1633;">
    <div class="max-w-6xl mx-auto px-4 py-14">
      <span class="inline-block bg-[#6a5fc1]/20 text-[#c2ef4e] text-[11px] font-bold uppercase tracking-[0.2px] rounded px-3 py-1 mb-4 border border-[#6a5fc1]/30">
        Intelligence Hub
      </span>
      <h1 class="text-white text-4xl md:text-5xl font-bold tracking-tight leading-none mb-3">
        미국주식 투자 정보
      </h1>
      <p class="text-[#e5e7eb]/60 text-base max-w-xl">
        ETF · 뉴스/루머 · 애널리스트 리포트 · 내부자 거래를 한국어로 정리합니다
      </p>
    </div>
  </div>

  <!-- Category Tabs — DARK/BORDER -->
  <div class="bg-[#1f1633] border-b border-[#362d59]">
    <div class="max-w-6xl mx-auto px-4">
      <nav class="flex flex-wrap gap-1 py-3">
        <a href="/blog" class="text-xs font-bold uppercase tracking-[0.2px] px-3 py-1.5 rounded bg-[#6a5fc1] text-white transition-all duration-150">
          전체
        </a>
        {CATEGORY_OPTIONS.map((cat) => (
          <a
            href={`/blog/category/${cat.value}`}
            class="text-xs font-bold uppercase tracking-[0.2px] px-3 py-1.5 rounded text-[#e5e7eb]/50 hover:text-white hover:bg-[#362d59] transition-all duration-150"
          >
            {cat.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Content — LIGHT -->
  <div class="min-h-screen bg-[#f0eeff]">

    <!-- Featured -->
    {featured && (
      <div class="bg-white border-b border-[#e4dcff]">
        <div class="max-w-6xl mx-auto px-4 py-10">
          <p class="text-[#79628c] text-xs font-bold uppercase tracking-[0.2px] mb-6">Featured Analysis</p>
          <a
            href={`/blog/${featured.id.replace(/\.[^.]+$/, "")}`}
            class="group grid grid-cols-1 md:grid-cols-2 gap-8 items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#6a5fc1] focus-visible:ring-offset-2 rounded"
          >
            <div class="aspect-[16/9] rounded-xl overflow-hidden bg-[#f0eeff] border border-[#e4dcff] order-1 md:order-2">
              {featured.data.thumbnail ? (
                <img src={featured.data.thumbnail} alt={featured.data.title} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" loading="eager" />
              ) : (
                <div class="w-full h-full flex items-center justify-center">
                  <span class="text-[#c4b5fd] text-5xl font-bold tracking-tighter">
                    {CATEGORY_LABELS[featured.data.category] ?? featured.data.category}
                  </span>
                </div>
              )}
            </div>
            <div class="order-2 md:order-1">
              <div class="flex items-center gap-3 mb-4">
                <span class={`inline-block text-[11px] font-bold uppercase tracking-[0.2px] rounded px-2 py-0.5 ${CATEGORY_BADGE[featured.data.category] ?? "bg-slate-100 text-slate-700"}`}>
                  {CATEGORY_LABELS[featured.data.category] ?? featured.data.category}
                </span>
                <span class="text-[#79628c] text-xs font-medium">{formatKoreanDate(featured.data.publishedAt)}</span>
              </div>
              <h2 class="text-[#1f1633] text-3xl md:text-4xl font-bold tracking-tight leading-[1.1] mb-4 group-hover:text-[#6a5fc1] transition-colors duration-150">
                {featured.data.title}
              </h2>
              <p class="text-[#4a3f6b] text-base leading-relaxed line-clamp-3 mb-6">{featured.data.description}</p>
              <span class="inline-flex items-center gap-1 text-[#1f1633] font-semibold text-sm group-hover:text-[#6a5fc1] transition-colors duration-150">
                분석 읽기 →
              </span>
            </div>
          </a>
        </div>
      </div>
    )}

    <!-- Grid -->
    <div class="max-w-6xl mx-auto px-4 py-12">
      {rest.length > 0 && (
        <>
          <p class="text-[#79628c] text-xs font-bold uppercase tracking-[0.2px] mb-6">Latest Intelligence</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {rest.map((post) => (
              <BlogCard
                slug={post.id.replace(/\.[^.]+$/, "")}
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                tags={post.data.tags}
                publishedAt={post.data.publishedAt}
                thumbnail={post.data.thumbnail}
              />
            ))}
          </div>
        </>
      )}
      {sorted.length === 0 && (
        <p class="text-[#79628c] text-center py-20 text-base">아직 게시물이 없습니다.</p>
      )}
    </div>

  </div>

</BaseLayout>
