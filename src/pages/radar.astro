---
import BaseLayout from "../layouts/BaseLayout.astro";
import IssueCard from "../components/radar/IssueCard.astro";
import { WaitlistForm } from "../components/islands/WaitlistForm";
import { dailyIssues, type DailyIssue } from "../data/daily-issues";
import { supabase, rowToIssue, type DailyIssueRow } from "../lib/supabase";
import { siteConfig } from "../config/site";

Astro.response.headers.set("Cache-Control", "no-store");

let issues: DailyIssue[] = dailyIssues;

if (supabase) {
  const { data, error } = await supabase
    .from("daily_issues")
    .select("*")
    .order("created_at", { ascending: false })
    .order("display_order", { ascending: true })
    .limit(100);

  if (error) {
    console.error("[radar] Supabase fetch error:", error.message);
  } else if (data && data.length > 0) {
    issues = (data as DailyIssueRow[]).map(rowToIssue);
  }
}

// 날짜별 그룹핑
function toKSTDateLabel(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("ko-KR", {
    timeZone: "Asia/Seoul",
    year: "numeric",
    month: "long",
    day: "numeric",
    weekday: "short",
  });
}

function toKSTDateKey(iso: string): string {
  const d = new Date(iso);
  // YYYY-MM-DD in KST
  return d.toLocaleDateString("ko-KR", {
    timeZone: "Asia/Seoul",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

// 날짜 키 순서 유지하면서 그룹핑
const groupMap = new Map<string, { label: string; issues: DailyIssue[] }>();
for (const issue of issues) {
  const key = issue.updatedAt ? toKSTDateKey(issue.updatedAt) : "기타";
  const label = issue.updatedAt ? toKSTDateLabel(issue.updatedAt) : "기타";
  if (!groupMap.has(key)) groupMap.set(key, { label, issues: [] });
  groupMap.get(key)!.issues.push(issue);
}
const groups = Array.from(groupMap.values());

const lastUpdated = issues[0]?.updatedAt
  ? new Date(issues[0].updatedAt).toLocaleString("ko-KR", {
      timeZone: "Asia/Seoul",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    })
  : null;

const todayLabel = groups[0]?.label ?? null;
---

<BaseLayout title={siteConfig.radarPageTitle} description={siteConfig.defaultDescription}>

  <!-- Hero — DARK -->
  <div class="bg-[#1f1633]" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(106,95,193,0.2) 0%, transparent 70%), #1f1633;">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <span class="inline-block bg-[#6a5fc1]/20 text-[#c2ef4e] text-[11px] font-bold uppercase tracking-[0.2px] rounded px-3 py-1 mb-4 border border-[#6a5fc1]/30">
        Market Intelligence Radar
      </span>
      <p class="text-[#e5e7eb]/50 text-sm font-medium mb-2">미국장 이슈를 날짜별로 아카이브합니다</p>
      <h1 class="text-white text-4xl font-bold sm:text-5xl tracking-tight leading-none mb-4">
        {siteConfig.radarPageTitle}
      </h1>
      <p class="max-w-3xl text-[#e5e7eb]/60 text-base leading-7 mb-8">
        확인된 사실·시장 관측·루머를 구분해 매일 정리합니다.<br />
        <span class="text-[#c2ef4e] font-semibold">스톡핑</span> 앱에서 더 많은 데이터를 확인할 수 있습니다.
      </p>
      <div>
        <a
          href="https://play.google.com/store/apps/details?id=kr.co.stockping.app&referrer=utm_source%3Dstockping_web%26utm_medium%3Dweb%26utm_campaign%3Dinstall"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-[#c2ef4e] px-6 py-3.5 text-base font-bold text-[#1f1633] transition hover:bg-[#d4f76a] shadow-[0_0_20px_rgba(194,239,78,0.3)]"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.76a2 2 0 0 0 2.15-.22l12.09-6.98-3.5-3.5-10.74 10.7zM.5 1.4A2 2 0 0 0 0 2.75v18.5a2 2 0 0 0 .5 1.35L.6 22.7l10.37-10.37v-.24L.6 1.72l-.1-.32zM20.65 10.4l-2.72-1.57-3.84 3.84 3.84 3.84 2.75-1.59a2.02 2.02 0 0 0 0-4.52zm-17.47 12.6L17.93 14.6l-3.5-3.5L3.18 21.76l-.01.01z"/></svg>
          Google Play 무료 다운로드
        </a>
        <p class="mt-2 text-sm text-[#e5e7eb]/50">Android · 무료</p>
      </div>
      {lastUpdated && (
        <p class="mt-4 flex items-center gap-1.5 text-xs text-[#e5e7eb]/40">
          <span class="h-1.5 w-1.5 rounded-full bg-[#c2ef4e] animate-pulse inline-block"></span>
          마지막 업데이트: {lastUpdated} KST
        </p>
      )}
    </div>
  </div>

  <!-- Issue history — LIGHT -->
  <div class="min-h-screen bg-[#f0eeff]">
    <div class="mx-auto max-w-6xl px-4 py-12">

      {groups.map((group, gi) => (
        <section class="mb-14">

          <!-- 날짜 헤더 -->
          <div class="mb-6 flex items-center gap-4">
            <div class="flex items-center gap-2.5">
              {gi === 0 && (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-[#c2ef4e] px-3 py-1 text-[11px] font-bold text-[#1f1633]">
                  <span class="h-1.5 w-1.5 rounded-full bg-[#1f1633] animate-pulse"></span>
                  오늘
                </span>
              )}
              <h2 class="text-lg font-bold text-[#1f1633]">{group.label}</h2>
            </div>
            <div class="h-px flex-1 bg-[#e4dcff]"></div>
            <span class="text-xs font-medium text-[#79628c]">{group.issues.length}개 이슈</span>
          </div>

          <!-- 이슈 카드 그리드 -->
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {group.issues.map((issue) => <IssueCard issue={issue} />)}
          </div>

        </section>
      ))}

      {groups.length === 0 && (
        <p class="py-20 text-center text-[#79628c]">등록된 이슈가 없습니다.</p>
      )}

      <div class="mt-4 rounded-xl border border-[#e4dcff] bg-white px-5 py-4 text-xs leading-6 text-[#79628c]">
        {siteConfig.radarDisclaimer}
      </div>
    </div>
  </div>

</BaseLayout>
